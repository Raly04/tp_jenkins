pipeline {
  agent {
    kubernetes {
      // this label will be the prefix of the generated pod's name
      label 'jenkins-agent-my-app'
      yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    component: ci
spec:
  containers:
    - name: jnlp
      volumeMounts:
        - mountPath: /home/jenkins/.ssh
          name: github-known-hosts
    - name: python
      image: python:3.7
      command:
        - cat
      tty: true
    - name: docker
      image: docker
      command:
        - cat
      tty: true
      env:
        - name: DOCKER_HOST
          value: unix:///var/run/docker-shared/docker.sock
      volumeMounts:
        - mountPath: /var/run/docker-shared
          name: docker-sock
    - name: dind
      image: docker:dind
      command:
        - dockerd
        - -H
        - unix:///var/run/docker-shared/docker.sock
      securityContext:
        privileged: true
      env:
        - name: DOCKER_TLS_CERTDIR
          value: ""
      volumeMounts:
        - mountPath: /var/run/docker-shared
          name: docker-sock
    - name: kubectl
      image: lachlanevenson/k8s-kubectl:v1.17.2 # use a version that match
      command:
        - cat
      tty: true
  volumes:
    - name: docker-sock
      emptyDir: {}
    - name: github-known-hosts
      configMap:
        name: github-known-hosts
"""
    }
  }
  // déclenchement automatique du pipeline à chaque push (poll toutes les minutes)
  triggers {
    pollSCM('* * * * *')
  }
  stages {
    stage('Test python') {
      steps {
        container('python') {
          dir('flask_app') {
            sh "pip install -r requirements.txt"
            sh "python test.py"
          }
        }
      }
    }
    stage('Build image') {
      steps {
        container('docker') {
          dir('flask_app') {
            sh "docker build -t localhost:4000/pythontest:latest ."
            sh "docker push localhost:4000/pythontest:latest"
          }
        }
      }
    }
    stage('Deploy') {
      steps {
        container('kubectl') {
          dir('flask_app') {
            sh "kubectl apply -f ./kubernetes/deployment.yaml"
            sh "kubectl apply -f ./kubernetes/service.yaml"
          }
        }
      }
    }
  }
}
